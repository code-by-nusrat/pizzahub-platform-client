# Better Auth
BETTER_AUTH_SECRET=replace_with_a_long_random_string
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_DB_URI=mongodb+srv://user:password@cluster.mongodb.net/pizzahubdb

# Express API
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ImgBB (server-side only)
IMGBB_API_KEY=your_imgbb_api_key

# Stripe (vendor subscriptions)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Optional: order status emails
RESEND_API_KEY=
EMAIL_FROM=PizzaHub <onboarding@resend.dev>
